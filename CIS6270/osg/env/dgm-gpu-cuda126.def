# Fallback image: OSG's Rocky 9 + CUDA 12.6 base with torch pinned explicitly.
#
# Use this instead of dgm-gpu.def if that one's %test fails -- transformers
# 4.57.6 is newer than the torch 2.3.1 in OSG's PyTorch base, and if the two
# turn out to be incompatible this route controls both pins directly. It is
# also the one to use if a run needs a torch feature 2.3 lacks.
#
# The cost is a slower build (torch is downloaded rather than inherited) and a
# larger .sif. cu124 wheels run on driver >= 550, which covers far more of the
# OSPool than the cu130 wheels pinned for this laptop.
#
# Build and stage exactly as for dgm-gpu.def, with its own version tag:
#
#   apptainer build --ignore-proot dgm-gpu-cuda126-v1.sif dgm-gpu-cuda126.def
#
Bootstrap: docker
From: hub.opensciencegrid.org/htc/rocky:9-cuda-12.6.0

%post
    set -eu
    dnf install -y python3.11 python3.11-pip git
    alternatives --install /usr/bin/python3 python3 /usr/bin/python3.11 1
    python3 -m pip install --no-cache-dir --upgrade pip

    # cu124 wheels: one minor below the 12.6 runtime in the base, which is the
    # supported direction (a CUDA runtime runs wheels built for an earlier minor).
    python3 -m pip install --no-cache-dir \
        --index-url https://download.pytorch.org/whl/cu124 \
        "torch==2.5.1"

    python3 -m pip install --no-cache-dir \
        "transformers==4.57.6" \
        "numpy>=1.24" \
        "scipy>=1.10" \
        "scikit-learn>=1.7.2" \
        "matplotlib>=3.8" \
        "wandb>=0.19"

%environment
    export HF_HUB_OFFLINE=1
    export TRANSFORMERS_OFFLINE=1
    export TOKENIZERS_PARALLELISM=false
    export MPLBACKEND=Agg

%test
    python3 - <<'PY'
import matplotlib, numpy, scipy, sklearn, torch, transformers
print("torch       ", torch.__version__)
print("transformers", transformers.__version__)
PY
