# One Project 1 experiment on an OSPool GPU node.
#
#   condor_submit run_experiment.sub
#
# Edit TAG and RUN_ARGS below, or override at submit time:
#   condor_submit run_experiment.sub -append 'TAG = k5_t07'
#
# Stage inputs once first with ../bin/stage.sh. Full runbook: ../README.md

# ── identity: the two values that are yours ──────────────────────────────────
OSG_USER = mukul.sherekar
OSG_AP   = ap40

# Two separate locations, deliberately. One variable for both is how the first
# smoke run's results.pt ended up under containers/runs/ instead of DGM/runs/.
#   OSDF_IMAGE  where the .sif lives, read on every job
#   OSDF_RUNS   where this run's heavy outputs are written
OSDF_IMAGE = osdf:///ospool/$(OSG_AP)/data/$(OSG_USER)/containers
OSDF_RUNS  = osdf:///ospool/$(OSG_AP)/data/$(OSG_USER)/DGM/runs

# Bump on every image rebuild: OSDF caches aggressively by file name.
IMAGE_VERSION = v3

# ── the run ──────────────────────────────────────────────────────────────────
# TAG names the output files, so keep it unique per run for the same reason.
TAG = long250

# ── the flags ────────────────────────────────────────────────────────────────
# Split deliberately into two groups, because they cost very differently.
#
# TRAINING-TIME flags change the model, so each value needs its own job and
# pays the full overhead: on job 15833630 that was 27 min of queue plus 21 min
# of image transfer before any compute. Vary these across jobs, in sweep.sub:
#   --epochs --arch --hidden --batch-size --interpolant --predict --ema
#   --diffusion-steps --seed --sample-seed
#
# SAMPLING-TIME flags read the same trained field, so extra values cost one
# more sampling pass each and nothing else. Put as many as you want HERE,
# inside one job -- this is how to get wide parameter coverage cheaply:
#   --cfg-weight --reward-eta --reward-lambda --setpoint --mut-budget
#   --decode-temperature --exact-mutations --restrict-support --anchor-strength
#
# Condor's quoted arguments form splits on spaces only, so comma-bearing values
# like 63,64,65 and multi-value flags like --cfg-weight 0 1 2 4 pass through
# untouched. --outdir, --no-oracle and the post-run steps are added by
# run_experiment.sh; do not set them here.
#
# Sampling cost scales as arms x samples x steps, and with
# --endpoint-guidance --normalize-guidance each step adds a backward pass per
# objective. Twelve arms at 100 samples is hours, not minutes -- see
# "Calibrating runtime" in ../README.md before trusting a short run's timing.
RUN_ARGS = --esm-model esm2_8m \
           --dataset data/avgfp_train_props.csv \
           --dataset-tag $(TAG) \
           --max-length 237 \
           --reference data/avgfp_wt.txt \
           --restrict-support data/avgfp_oracle_v2.npz \
           --minimize 2 \
           --constraint-property 3 --constraint-rho 1.0 \
           --arch transformer --hidden 256 \
           --batch-size 128 --epochs 500 \
           --diffusion-steps 200 \
           --normalize-guidance --endpoint-guidance \
           --guidance-clip 2.0 \
           --plot \
           --mut-budget 10 5 3 \
           --decode-temperature 0.7 \
           --freeze-positions 63,64,65 \
           --cfg-weight 0 1 2 4 \
           --reward-eta 10 30 60 \
           --reward-lambda 0.3 0.5 0.7 \
           --setpoint 50 90 99 --setpoint-percentile --setpoint-saturation 6 \
           --samples 100
#
# --epochs 500, with require_gpus below bounding which GPUs may take it:
# measured ~24 s per epoch-unit on an H100 (so ~7.7 h) against ~81 s on an A40
# (~25.6 h, past the 20 h ceiling). Run ONE job to completion before
# committing a sweep at this length.
#
# --mut-budget 10 5 3 as a CEILING, with --exact-mutations dropped. Fixing the
# count made the lambda arms degenerate -- cli.py says so, and the 125-epoch
# run confirmed it: lam0.3, lam0.5 and lam0.7 all decoded to the same first
# sequence at an identical Hamming 5.0. Three budgets decode the same latents,
# so the extra two cost a decode each and no sampling. 10 stays inside the
# oracle's recorded max_mutations of 15. Expect some unmutated reference in the
# output now; watch the %wt column in the metric table.
#
# --guidance-clip 2.0 and --reward-eta 10 30 60 instead of 30 100. At eta=100
# the setpoint arms lost 10-13 of 100 samples to numerical divergence, latent
# norms reaching 5,385 against a median of 250. Objective.term_scale returns
# 2*(setpoint - predicted) clamped to +/- --setpoint-saturation, so at 6 a
# setpoint arm carries up to 6x the gradient of any other arm under
# --normalize-guidance. The clip is applied per sample after the weighted sum,
# so it bounds the far samples while leaving the controller's deceleration near
# target intact -- which is what lowering --setpoint-saturation would destroy.
#
# --plot produces 9 figures and 8 metric CSVs on the node, including the
# training-loss curves, and run_experiment.sh returns them in the tarball along
# with the metric table and the three study figures. Add --ablate for the two
# guidance-sweep panels (11 and 10); it re-samples the trained models, so it
# costs extra GPU time.

# ── container ────────────────────────────────────────────────────────────────
# container_image takes no quotes, and the .sif must NOT appear under
# transfer_input_files -- Condor stages it for you.
universe        = container
container_image = $(OSDF_IMAGE)/dgm-gpu-$(IMAGE_VERSION).sif

executable = run_experiment.sh
arguments  = "$(TAG) $(RUN_ARGS)"

# ── input ────────────────────────────────────────────────────────────────────
# All three sit well under the 1 GB mark above which OSG asks for OSDF:
# code ~1 MB, this run's data ~13 MB, esm2_8m weights ~30 MB.
# For esm2_650m (2.5 GB) or bigger, drop esm-cache.tar.gz and use instead:
#   transfer_input_files = dgm-src.tar.gz, inputs.tar.gz, \
#       osdf:///ospool/$(OSG_AP)/data/$(OSG_USER)/DGM/data/esm-cache/?recursive
transfer_input_files = dgm-src.tar.gz, inputs.tar.gz, esm-cache.tar.gz

# ── output ───────────────────────────────────────────────────────────────────
# The small tarball comes home; the two results.pt files (200-400 MB each) are
# remapped into OSDF so they never land on the access point.
should_transfer_files   = YES
# ON_EXIT transfers nothing when a job is evicted, which is how job 15833707
# lost three hours of finished sampling to a memory kill. ON_EXIT_OR_EVICT
# copies the named output files into the access point's SPOOL at eviction, so
# they survive -- which is only useful because run_experiment.sh now stages
# results.pt before anything memory-hungry runs. Condor holds the job if a
# named file is missing at eviction, hence the empty placeholders.
when_to_transfer_output = ON_EXIT_OR_EVICT
transfer_output_files   = $(TAG).tar.gz, $(TAG)_flow_results.pt, $(TAG)_diffusion_results.pt, $(TAG)_manifest.txt
transfer_output_remaps  = "$(TAG)_flow_results.pt = $(OSDF_RUNS)/$(TAG)/flow_results.pt; $(TAG)_diffusion_results.pt = $(OSDF_RUNS)/$(TAG)/diffusion_results.pt; $(TAG)_manifest.txt = $(OSDF_RUNS)/$(TAG)/manifest.txt"

# ── environment the job script reads ─────────────────────────────────────────
# These MUST go through `environment`. A bare `OSG_WANDB = 1` in a submit file
# defines a Condor macro, not a job environment variable, and condor_submit
# warns "was unused by condor_submit" -- the job never sees it.
#
#   OSG_WANDB              1 = write an offline W&B run into the results dir,
#                          which the tarball carries home for `wandb sync` on
#                          the access point. Needs wandb in the image (v2 does).
#   OSG_METRICS            0 = skip the gfp_metrics table and the study figures
#   OSG_BASELINE_N         random variants per setting for the control
#   OSG_HEARTBEAT_SECONDS  how often the "alive" line prints, for tailing .out
#   OSG_WITH_ORACLE        1 = score inline; needs METL in the image, which it
#                          is not, so leave at 0 and score afterwards
environment = "OSG_WANDB=1 OSG_METRICS=1 OSG_BASELINE_N=50 OSG_HEARTBEAT_SECONDS=300 OSG_WITH_ORACLE=0"

# ── resources ────────────────────────────────────────────────────────────────
# CONFIRMED against a real OSPool run on an L40 (job 15833608, NCSU-OSG-CE1):
#   Memory  usage 24,861 MB of 32,768 requested   <- 16GB would have been killed
# but that was 12 arms WITHOUT --plot. The 20-arm config with --plot reached
# 35,369 MB and was killed (job 15833707) by a quadratic pairwise-Hamming loop
# over all 41,372 training sequences, now subsampled. 48GB carries the fixed
# version with margin.
#   Cpus    usage 1.99 of 2                       <- saturated; see the note below
#   Disk    usage 9.0 GiB of 16 GiB               <- the .sif IS the disk request
#   GPUs    usage 0.06                            <- 6%: the job is CPU-bound
#
# request_disk is dominated by the container image, not by the data: that run
# received 9.51 GB, essentially all of it the ~8.8 GiB .sif. Inputs are 21 MB
# and outputs ~780 MB for a full 100-sample run.
#
# Cpus sat at 1.99 of 2 while the GPU idled at 6%, because load_data encodes at
# the module-level BATCH_SIZE of 16 in a plain Python loop with no DataLoader
# workers. Raising this to 4 is cheap and worth one A/B against TimeExecute; it
# matters less on a 250-epoch run, where training rather than encoding dominates.
request_gpus   = 1
request_cpus   = 4
request_memory = 48GB
request_disk   = 48GB

# The image's cu118 wheels cover sm_70 to sm_90: V100, A100, A40, L40S.
# Ruling out older cards avoids matching a node that cannot run them at all.
# Measured per-epoch cost differs by ~3.4x across the GPUs this work landed on:
# ~24 s per epoch-unit on an H100 (Capability 9.0) against ~81 s on an A40
# (8.6). At 500 epochs that is 7.7 h against 25.6 h -- the second blows past
# the 20 h "Long" ceiling and loses the run. So the 8.6 tier is excluded while
# A100 (8.0), L40 (8.9) and H100 (9.0) are kept; anything below 8.0 is older
# still. Fewer eligible nodes means a longer queue, which is the price of a
# predictable runtime. Relax to (Capability >= 7.0) if you drop back to <= 250
# epochs and would rather have the capacity.
require_gpus        = (Capability != 8.6 && Capability >= 8.0)
# 8,028 MB on the A40 (12 arms) and 9,516 MB on the H100 (20 arms). Back to
# 12G: 10G left only 700 MB of headroom, and a node with exactly 10 GB would
# have run out.
# (Condor reported only 1,282 MB for the 2-epoch smoke run -- it samples
# nvidia-smi periodically and caught the encode phase. Ignore that number.)
gpus_minimum_memory = 12G

# MEASURED, and important: the full 250-epoch long250 config ran over 21 hours
# on the GB10 and was still sampling. That exceeds BOTH OSPool categories --
# "Medium" is 10 h, "Long" is 20 h -- so 250 epochs cannot complete as a single
# OSPool job. The job will be held.
#
# The loss curve says those epochs buy little past the halfway point: flow went
# 0.3733 at epoch 124 to 0.3156 at 250, diffusion 0.1808 to 0.1663. Halving to
# --epochs 125 lands near 10.5 h, which fits "Long" with margin. Reduce
# --epochs above before submitting.
+JobDurationCategory = "Long"

# ── logging and retries ──────────────────────────────────────────────────────
# Stream stdout and stderr back to the access point as the job runs, instead
# of transferring them only on exit. Default is False, which is why .out and
# .err appeared only when a job finished. The cost is negligible here: this job
# prints a few dozen lines over many hours.
stream_output = True
stream_error  = True

output = logs/$(TAG).$(ClusterId).$(ProcId).out
error  = logs/$(TAG).$(ClusterId).$(ProcId).err
log    = logs/$(TAG).$(ClusterId).log


max_retries = 3

queue 1
